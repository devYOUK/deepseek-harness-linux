#!/bin/sh
# Run the installed CLI without changing the invoking shell or working directory.
set -e
launcher=$0
while [ -L "$launcher" ]; do
  directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd -P)
  target=$(readlink "$launcher")
  case "$target" in
    /*) launcher=$target ;;
    *) launcher=$directory/$target ;;
  esac
done
resources=$(CDPATH= cd -- "$(dirname -- "$launcher")/../../.." && pwd -P)
# Linux packs the executable beside resources/; macOS keeps it under Contents/MacOS.
app="$resources/../deepseek-harness"
if [ ! -x "$app" ]; then app="$resources/../DeepSeek Harness"; fi
if [ ! -x "$app" ]; then app="$resources/../MacOS/DeepSeek Harness"; fi
ELECTRON_RUN_AS_NODE=1 exec "$app" --expose-internals "$resources/app.asar/dsh/node_modules/@deepseek-ai/dsh-desktop-host/lib/cli.js" "$@"
